{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "qr-guardian-api",
  "main": "src/index.js",
  "compatibility_date": "2026-07-22",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "ratelimits": [
    {
      "name": "URL_CHECK_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ]
}